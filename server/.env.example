# Everything here is optional. With no .env at all, the app runs on a built-in local MongoDB.

# Use your own MongoDB or Atlas instead of the built-in one:
# MONGO_URI=mongodb://127.0.0.1:27017/quiz-master

# JWT_SECRET=use-a-long-random-string-in-production
# PORT=5000
# CLIENT_URL=http://localhost:5173
